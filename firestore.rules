rules_version = '2';

// =============================================================================
// PSgy — Firestore Security Rules
// Project: psgy-app | Platforms: iOS + Android (User + Coach apps)
//
// Golden Rule: this local file is the source of truth.
// Deploy via scripts/deploy_firestore_rules.sh (do not edit rules in Console).
//
// Collection rules for gym / coach / booking will be added by the backend team.
// Default is deny-all until those rules exist.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthenticated() {
      return isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
