rules_version = '2';

// =============================================================================
// ParkingLink — Production Firestore Security Rules (CP25)
// Project: parkinglink-v2 | Platforms: iOS + Android (User + Staff apps)
//
// Design principles:
//   • Security > Convenience
//   • All client writes require authentication
//   • Role derived from staff_profiles (owner | staff)
//   • End-users (User app) = unauthenticated or no staff_profiles → read-only map data
//   • surveying_lots = public read, zero client writes (Monitor / Admin SDK only)
//   • Rate limiting remains only on cold paths; hot staff/owner paths rely on validation
//
// Deploy:
//   firebase deploy --only firestore:rules --project parkinglink-v2
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Constants
    // -------------------------------------------------------------------------
    function maxWritesPerMinute() {
      return 30;
    }

    function validPricingModels() {
      return ['per_trip', 'per_day', 'per_hour', 'monthly'];
    }

    function validLotStatuses() {
      return ['open', 'closed', 'maintenance'];
    }

    function validSlotStatuses() {
      return ['empty', 'occupied', 'reserved', 'maintenance'];
    }

    // -------------------------------------------------------------------------
    // Auth & identity helpers
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthenticated() {
      return isSignedIn();
    }

    function hasAdminClaim() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/staff_profiles/$(uid);
    }

    function lotPath(lotId) {
      return /databases/$(database)/documents/parking_lots/$(lotId);
    }

    function hasProfile() {
      return isSignedIn() && exists(profilePath(request.auth.uid));
    }

    function currentProfile() {
      return get(profilePath(request.auth.uid));
    }

    function isActiveProfile() {
      return hasProfile() && currentProfile().data.isActive == true;
    }

    function isActiveStaffOrOwner() {
      return isActiveProfile()
        && currentProfile().data.role in ['staff', 'owner'];
    }

    function isNewOwnerWithoutLot() {
      return hasProfile()
        && currentProfile().data.role == 'owner'
        && currentProfile().data.isActive == true
        && (
          !('lotId' in currentProfile().data)
          || currentProfile().data.lotId == null
          || (
            currentProfile().data.lotId is string
            && !exists(lotPath(currentProfile().data.lotId))
          )
        );
    }

    function hasRole(role) {
      return isActiveProfile() && currentProfile().data.role == role;
    }

    function isOwner() {
      return hasRole('owner');
    }

    function isStaff() {
      return hasRole('staff');
    }

    function isStaffOrOwner() {
      return isActiveStaffOrOwner();
    }

    function isAssignedToLot(lotId) {
      return isActiveProfile() && currentProfile().data.lotId == lotId;
    }

    function isOwnerOfLot(lotId) {
      return isOwner()
        && (
          isAssignedToLot(lotId)
          || (
            exists(lotPath(lotId))
            && get(lotPath(lotId)).data.ownerId == request.auth.uid
          )
        );
    }

    function isOwnerOfLotAfterWrite(lotId) {
      return isOwner()
        && (
          isOwnerOfLot(lotId)
          || (
            existsAfter(lotPath(lotId))
            && getAfter(lotPath(lotId)).data.ownerId == request.auth.uid
          )
        );
    }

    function isNewOwnerCreatingLot(lotId) {
      return isNewOwnerWithoutLot()
        && existsAfter(lotPath(lotId))
        && getAfter(lotPath(lotId)).data.ownerId == request.auth.uid;
    }

    function isStaffOfLot(lotId) {
      return isStaff() && isAssignedToLot(lotId);
    }

    function canWorkOnLot(lotId) {
      return isStaffOfLot(lotId);
    }

    function canAccessLot(lotId) {
      return isOwnerOfLot(lotId) || canWorkOnLot(lotId);
    }

    // -------------------------------------------------------------------------
    // Rate limiting (_security/rate_limits/{uid}/buckets/{minuteBucket})
    // Client SHOULD increment bucket in the same transaction/batch as writes.
    // Rules block writes when bucket count >= maxWritesPerMinute().
    // -------------------------------------------------------------------------
    function minuteBucket() {
      return string(int(request.time.toMillis() / 60000));
    }

    function rateLimitRef(uid) {
      return /databases/$(database)/documents/_security/rate_limits/$(uid)/buckets/$(minuteBucket());
    }

    function withinWriteRateLimit() {
      return !exists(rateLimitRef(request.auth.uid))
        || get(rateLimitRef(request.auth.uid)).data.count < maxWritesPerMinute();
    }

    function validRateLimitCreate() {
      return request.resource.data.keys().hasOnly(['count', 'updatedAt'])
        && request.resource.data.count == 1
        && request.resource.data.updatedAt is timestamp;
    }

    function validRateLimitIncrement() {
      return request.resource.data.keys().hasOnly(['count', 'updatedAt'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.count <= maxWritesPerMinute()
        && request.resource.data.updatedAt is timestamp;
    }

    match /_security/rate_limits/{uid}/buckets/{bucketId} {
      allow read: if isSignedIn() && request.auth.uid == uid;

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && bucketId == minuteBucket()
        && validRateLimitCreate();

      allow update: if isSignedIn()
        && request.auth.uid == uid
        && bucketId == minuteBucket()
        && validRateLimitIncrement();

      allow delete: if false;
    }

    // Deny all other _security paths
    match /_security/{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Field validators
    // -------------------------------------------------------------------------
    function isNonEmptyString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function isValidVehiclePlate(plate) {
      return isNonEmptyString(plate, 20);
    }

    function isValidVehicleTypeId(typeId) {
      return isNonEmptyString(typeId, 32);
    }

    function isValidTimestampField(value) {
      return value is timestamp;
    }

    function lotHasAvailableSlot(lotId, vehicleTypeId) {
      let vtRef = /databases/$(database)/documents/parking_lots/$(lotId)/vehicle_types/$(vehicleTypeId);
      return exists(vtRef)
        && get(vtRef).data.availableSlots is int
        && get(vtRef).data.availableSlots > 0;
    }

    function lotIsOpen(lotId) {
      return exists(lotPath(lotId))
        && get(lotPath(lotId)).data.status == 'open';
    }

    // -------------------------------------------------------------------------
    // staff_profiles
    // -------------------------------------------------------------------------
    function validStaffProfileFields() {
      return request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'role',
          'lotId',
          'isActive',
          'createdAt',
          'updatedAt'
        ])
        && isNonEmptyString(request.resource.data.uid, 128)
        && isNonEmptyString(request.resource.data.name, 120)
        && isNonEmptyString(request.resource.data.email, 254)
        && request.resource.data.role == 'staff'
        && isNonEmptyString(request.resource.data.lotId, 128)
        && request.resource.data.isActive is bool
        && isValidTimestampField(request.resource.data.createdAt)
        && isValidTimestampField(request.resource.data.updatedAt);
    }

    function validStaffProfileCreate(uid) {
      return validStaffProfileFields()
        && request.resource.data.uid == uid
        && exists(lotPath(request.resource.data.lotId))
        && isOwnerOfLot(request.resource.data.lotId);
    }

    function validStaffProfileToggle() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isActive', 'updatedAt'])
        && resource.data.role == 'staff'
        && request.resource.data.role == resource.data.role
        && request.resource.data.lotId == resource.data.lotId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.isActive is bool
        && isValidTimestampField(request.resource.data.updatedAt);
    }

    function validNewOwnerSelfCreate(uid) {
      return uid == request.auth.uid
        && !exists(profilePath(uid))
        && request.resource.data.keys().hasOnly([
            'uid',
            'name',
            'email',
            'role',
            'lotId',
            'isActive',
            'createdAt',
            'updatedAt'
          ])
        && request.resource.data.uid == uid
        && request.resource.data.role == 'owner'
        && request.resource.data.isActive == true
        && request.resource.data.lotId == null
        && isNonEmptyString(request.resource.data.name, 120)
        && isNonEmptyString(request.resource.data.email, 254)
        && isValidTimestampField(request.resource.data.createdAt)
        && isValidTimestampField(request.resource.data.updatedAt);
    }

    // One-time owner bootstrap: lot.ownerId must match auth uid (Admin SDK preferred in prod)
    function validOwnerProfileBootstrap(uid) {
      return uid == request.auth.uid
        && !exists(profilePath(uid))
        && request.resource.data.keys().hasOnly([
            'uid',
            'name',
            'email',
            'role',
            'lotId',
            'isActive',
            'createdAt',
            'updatedAt'
          ])
        && request.resource.data.uid == uid
        && request.resource.data.role == 'owner'
        && request.resource.data.isActive == true
        && isNonEmptyString(request.resource.data.lotId, 128)
        && exists(lotPath(request.resource.data.lotId))
        && get(lotPath(request.resource.data.lotId)).data.ownerId == request.auth.uid;
    }

    match /staff_profiles/{uid} {
      allow get: if isSignedIn()
        && (
          uid == request.auth.uid
          || (
            isOwner()
            && resource.data.lotId == currentProfile().data.lotId
          )
        );

      allow list: if isOwner()
        && resource.data.lotId is string
        && isOwnerOfLot(resource.data.lotId);

      allow create: if isSignedIn()
        && (
          hasAdminClaim()
          || validOwnerProfileBootstrap(uid)
          || validNewOwnerSelfCreate(uid)
          || (isOwner() && validStaffProfileCreate(uid))
        );

      allow update: if isSignedIn()
        && uid == request.auth.uid
        && (
          (
            isOwner()
            && resource.data.lotId == currentProfile().data.lotId
            && validStaffProfileToggle()
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lotId', 'updatedAt'])
            && resource.data.role == 'owner'
            && resource.data.isActive == true
            && uid == request.auth.uid
          )
        );

      allow delete: if false;

      match /activity_log/{logId} {
        allow read: if isSignedIn()
          && (
            uid == request.auth.uid
            || (
              isOwner()
              && exists(profilePath(uid))
              && get(profilePath(uid)).data.lotId == currentProfile().data.lotId
            )
          );

        allow create: if isSignedIn()
          && withinWriteRateLimit()
          && isOwner()
          && exists(profilePath(uid))
          && get(profilePath(uid)).data.lotId == currentProfile().data.lotId
          && request.resource.data.keys().hasOnly([
              'action',
              'changedBy',
              'changedAt',
              'createdAt',
              'updatedAt'
            ])
          && request.resource.data.action in ['locked', 'unlocked']
          && request.resource.data.changedBy == request.auth.uid
          && isValidTimestampField(request.resource.data.changedAt);

        allow update, delete: if false;
      }
    }

    // -------------------------------------------------------------------------
    // parking_lots (+ subcollections)
    // -------------------------------------------------------------------------
    function validLotStatusUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.status in validLotStatuses()
        && isValidTimestampField(request.resource.data.updatedAt);
    }

    function validOwnerVehicleTypeUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'totalSlots',
            'availableSlots',
            'pricingModel',
            'priceAmount',
            'monthlyAmount',
            'updatedAt'
          ])
        && request.resource.data.totalSlots is int
        && request.resource.data.availableSlots is int
        && request.resource.data.totalSlots >= 0
        && request.resource.data.availableSlots >= 0
        && request.resource.data.availableSlots <= request.resource.data.totalSlots
        && request.resource.data.pricingModel in validPricingModels()
        && request.resource.data.priceAmount is int
        && request.resource.data.priceAmount >= 0
        && (
          !('monthlyAmount' in request.resource.data)
          || request.resource.data.monthlyAmount == null
          || (
            request.resource.data.monthlyAmount is int
            && request.resource.data.monthlyAmount >= 0
          )
        );
    }

    function validStaffVehicleTypeSlotChange() {
      let previous = resource.data.availableSlots;
      let next = request.resource.data.availableSlots;
      let delta = next - previous;
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['availableSlots', 'updatedAt'])
        && previous is int
        && next is int
        && delta in [-1, 1]
        && next >= 0
        && next <= resource.data.totalSlots
        && (
          delta != -1
          || previous > 0
        );
    }

    function validStaffSlotOccupancyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'vehiclePlate',
            'checkedInAt',
            'staffId',
            'updatedAt'
          ])
        && request.resource.data.status in validSlotStatuses()
        && (
          request.resource.data.vehiclePlate == null
          || isValidVehiclePlate(request.resource.data.vehiclePlate)
        )
        && (
          request.resource.data.staffId == null
          || request.resource.data.staffId == request.auth.uid
        );
    }

    function validManualAdjustmentCreate(lotId) {
      return request.resource.data.keys().hasOnly([
          'id',
          'vehicleType',
          'delta',
          'reason',
          'staffId',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.staffId == request.auth.uid
        && isValidVehicleTypeId(request.resource.data.vehicleType)
        && request.resource.data.delta in [-1, 1]
        && (
          !('reason' in request.resource.data)
          || request.resource.data.reason == null
          || isNonEmptyString(request.resource.data.reason, 500)
        )
        && isValidTimestampField(request.resource.data.createdAt)
        && isValidTimestampField(request.resource.data.updatedAt)
        && canWorkOnLot(lotId)
        && lotIsOpen(lotId);
    }

    match /parking_lots/{lotId} {
      // User app: public read for map discovery (no auth required)
      allow read: if true;

      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && (
          isActiveStaffOrOwner()
          || isNewOwnerWithoutLot()
        );

      allow update: if isSignedIn()
        && withinWriteRateLimit()
        && isOwnerOfLot(lotId)
        && validLotStatusUpdate();

      allow delete: if false;

      match /vehicle_types/{vehicleTypeId} {
        // User app reads availability + pricing for map cards
        allow read: if true;

        allow create: if isAuthenticated()
          && (
            isOwnerOfLotAfterWrite(lotId)
            || isNewOwnerCreatingLot(lotId)
          );

        allow delete: if false;

        allow update: if isSignedIn()
          && lotIsOpen(lotId)
          && (
            (isOwnerOfLot(lotId) && validOwnerVehicleTypeUpdate())
            || (isStaffOfLot(lotId) && validStaffVehicleTypeSlotChange())
          );
      }

      match /slots/{slotId} {
        allow read: if canAccessLot(lotId);

        allow create, delete: if isSignedIn()
          && withinWriteRateLimit()
          && isOwnerOfLot(lotId);

        allow update: if isSignedIn()
          && lotIsOpen(lotId)
          && (
            isOwnerOfLot(lotId)
            || (isStaffOfLot(lotId) && validStaffSlotOccupancyUpdate())
          );
      }

      match /manual_adjustments/{adjustmentId} {
        allow read: if canAccessLot(lotId);

        allow create: if isSignedIn()
          && validManualAdjustmentCreate(lotId);

        allow update, delete: if false;
      }

      // Owner-only sensitive analytics (revenue, payroll) — future-proof
      match /owner_private/{docId} {
        allow read, write: if isSignedIn()
          && withinWriteRateLimit()
          && isOwnerOfLot(lotId);
      }
    }

    // -------------------------------------------------------------------------
    // parking_sessions — check-in/out with business-rule validation
    // -------------------------------------------------------------------------
    function validSessionCreate() {
      return request.resource.data.keys().hasOnly([
          'id',
          'lotId',
          'vehicleType',
          'vehiclePlate',
          'checkedInAt',
          'status',
          'staffId',
          'metadata',
          'createdAt',
          'updatedAt',
          'userId',
          'vehicleId',
          'vehiclePhotoUrl',
          'checkInMethod'
        ])
        && isNonEmptyString(request.resource.data.id, 128)
        && isNonEmptyString(request.resource.data.lotId, 128)
        && isValidVehicleTypeId(request.resource.data.vehicleType)
        && isValidVehiclePlate(request.resource.data.vehiclePlate)
        && request.resource.data.status == 'active'
        && request.resource.data.staffId == request.auth.uid
        && isValidTimestampField(request.resource.data.checkedInAt)
        && isValidTimestampField(request.resource.data.createdAt)
        && isValidTimestampField(request.resource.data.updatedAt)
        && request.resource.data.metadata is map
        && canWorkOnLot(request.resource.data.lotId)
        && lotIsOpen(request.resource.data.lotId)
        && lotHasAvailableSlot(
          request.resource.data.lotId,
          request.resource.data.vehicleType
        );
    }

    function validSessionCheckout() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'checkedOutAt',
            'checkOutStaffId',
            'updatedAt',
            'checkOutMethod',
            'checkOutTokenId'
          ])
        && resource.data.status == 'active'
        && request.resource.data.status == 'completed'
        && request.resource.data.lotId == resource.data.lotId
        && request.resource.data.vehicleType == resource.data.vehicleType
        && request.resource.data.vehiclePlate == resource.data.vehiclePlate
        && request.resource.data.staffId == resource.data.staffId
        && request.resource.data.checkOutStaffId == request.auth.uid
        && isValidTimestampField(request.resource.data.checkedOutAt)
        && isValidTimestampField(request.resource.data.updatedAt)
        && canWorkOnLot(resource.data.lotId)
        && lotIsOpen(resource.data.lotId);
    }

    match /parking_sessions/{sessionId} {
      allow get: if isSignedIn()
        && (canAccessLot(resource.data.lotId)
            || resource.data.userId == request.auth.uid);

      allow list: if isSignedIn()
        && isActiveStaffOrOwner();

      allow create: if isSignedIn()
        && validSessionCreate();

      allow update: if isSignedIn()
        && validSessionCheckout();

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // pricing_history — audit trail, owner/staff read, owner write
    // -------------------------------------------------------------------------
    match /pricing_history/{historyId} {
      allow get: if isSignedIn()
        && canAccessLot(resource.data.lotId);

      allow list: if isSignedIn()
        && isActiveStaffOrOwner();

      allow create: if isSignedIn()
        && (
          isOwnerOfLot(request.resource.data.lotId)
          || (
            isOwner()
            && existsAfter(lotPath(request.resource.data.lotId))
            && getAfter(lotPath(request.resource.data.lotId)).data.ownerId == request.auth.uid
          )
          || isNewOwnerCreatingLot(request.resource.data.lotId)
        )
        && request.resource.data.keys().hasOnly([
            'lotId',
            'vehicleTypeId',
            'oldPrice',
            'newPrice',
            'pricingModel',
            'changedBy',
            'changedAt',
            'createdAt',
            'updatedAt'
          ])
        && isNonEmptyString(request.resource.data.lotId, 128)
        && isValidVehicleTypeId(request.resource.data.vehicleTypeId)
        && request.resource.data.oldPrice is int
        && request.resource.data.newPrice is int
        && request.resource.data.oldPrice >= 0
        && request.resource.data.newPrice >= 0
        && request.resource.data.pricingModel in validPricingModels()
        && request.resource.data.changedBy == request.auth.uid
        && isValidTimestampField(request.resource.data.changedAt);

      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // bookings — future User reservations (authenticated end-users)
    // -------------------------------------------------------------------------
    function validBookingCreate() {
      return request.resource.data.keys().hasOnly([
          'id',
          'userId',
          'lotId',
          'vehicleType',
          'vehiclePlate',
          'status',
          'startsAt',
          'endsAt',
          'metadata',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && isNonEmptyString(request.resource.data.lotId, 128)
        && isValidVehicleTypeId(request.resource.data.vehicleType)
        && isValidVehiclePlate(request.resource.data.vehiclePlate)
        && request.resource.data.status in ['pending', 'confirmed']
        && isValidTimestampField(request.resource.data.startsAt)
        && isValidTimestampField(request.resource.data.endsAt)
        && request.resource.data.endsAt > request.resource.data.startsAt
        && lotIsOpen(request.resource.data.lotId);
    }

    function validBookingCustomerUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'cancelledAt', 'updatedAt'])
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.lotId == resource.data.lotId
        && resource.data.status in ['pending', 'confirmed']
        && request.resource.data.status == 'cancelled'
        && isValidTimestampField(request.resource.data.cancelledAt);
    }

    function validBookingStaffUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.lotId == resource.data.lotId
        && request.resource.data.status in [
          'pending',
          'confirmed',
          'checked_in',
          'completed',
          'cancelled'
        ];
    }

    match /bookings/{bookingId} {
      allow read: if isSignedIn()
        && (
          resource.data.userId == request.auth.uid
          || canAccessLot(resource.data.lotId)
        );

      allow create: if isSignedIn()
        && withinWriteRateLimit()
        && validBookingCreate();

      allow update: if isSignedIn()
        && withinWriteRateLimit()
        && (
          (
            resource.data.userId == request.auth.uid
            && validBookingCustomerUpdate()
          )
          || (
            canAccessLot(resource.data.lotId)
            && validBookingStaffUpdate()
          )
        );

      allow delete: if false;
    }

    match /surveying_lots/{lotId} {
      // Public read
      allow read: if true;
      // Tạo mới: chỉ qua pipeline (deny client)
      allow create: if false;
      // Admin Monitor tool có thể update/delete bãi tĩnh
      allow update, delete: if true;
    }

    // User watchlist — anonymous or authenticated end-users
    match /users/{uid}/watchlist/{lotId} {
      allow read: if isSignedIn() && request.auth.uid == uid;

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && withinWriteRateLimit()
        && request.resource.data.keys().hasOnly([
            'lotId',
            'lotName',
            'watchedAt',
            'estimatedOpeningAt',
            'notifyOnOpen',
            'fcmTopic',
            'updatedAt'
          ])
        && request.resource.data.lotId == lotId
        && request.resource.data.notifyOnOpen == true;

      allow update: if isSignedIn()
        && request.auth.uid == uid
        && withinWriteRateLimit()
        && request.resource.data.lotId == resource.data.lotId;

      allow delete: if isSignedIn()
        && request.auth.uid == uid
        && withinWriteRateLimit();
    }

    // ── User Profile (MOD-12b-1) ───────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null
          && request.auth.uid == userId;
    }

    // ── User Vehicles ───────────────────────────────────────────────────────
    match /user_vehicles/{vehicleId} {
      allow create: if request.auth != null
          && request.auth.uid == request.resource.data.userId;
      allow read, update, delete: if request.auth != null
          && request.auth.uid == resource.data.userId;
      allow read: if request.auth != null && isStaffOrOwner();
    }

    // ── QR Tokens (MOD-12b-2 prep) ──────────────────────────────────────────
    match /qr_tokens/{tokenId} {
      allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.used == false;
      allow read: if request.auth != null
          && (resource.data.userId == request.auth.uid
              || isStaffOrOwner());
      allow update: if request.auth != null && (
        (isStaffOrOwner()
          && resource.data.used == false
          && request.resource.data.used == true
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['used', 'usedAt', 'sessionId']))
        ||
        (request.auth.uid == resource.data.userId
          && resource.data.used == false
          && request.resource.data.used == true
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['used', 'usedAt', 'cancelledByUser']))
      );
      allow delete: if false;
    }

    // ── Check-out QR Tokens (MOD-12b-4) ─────────────────────────────────────
    match /checkout_qr_tokens/{tokenId} {
      // User tạo token cho mình
      allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.used == false;

      // User đọc token mình, staff/owner đọc để scan
      allow read: if request.auth != null
          && (resource.data.userId == request.auth.uid
              || isStaffOrOwner());

      allow update: if request.auth != null && (
        // Staff/owner complete checkout
        (isStaffOrOwner()
          && resource.data.used == false
          && request.resource.data.used == true
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['used', 'usedAt', 'checkOutStaffId']))
        ||
        // User tự huỷ
        (request.auth.uid == resource.data.userId
          && resource.data.used == false
          && request.resource.data.used == true
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['used', 'usedAt', 'cancelledByUser']))
      );

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Default deny — no wildcard allow
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

 
 
 
